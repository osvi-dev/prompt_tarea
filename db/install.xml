<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/prompt_tarea/db" VERSION="20250111" COMMENT="XMLDB file for Moodle local/prompt_tarea"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_prompt_tarea" COMMENT="Almacena prompts para tareas">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="assignid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="ID de la tarea"/>
        <FIELD NAME="prompt" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Texto del prompt del profesor"/>
        <FIELD NAME="prompt_estudiante" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Prompt para retroalimentacion el estudiante"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="assignid" TYPE="foreign" FIELDS="assignid" REFTABLE="assign" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="assignid_idx" UNIQUE="true" FIELDS="assignid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
